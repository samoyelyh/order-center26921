# 后端环境变量示例
# 复制为 .env 并按需修改（本文件仅作文档，后端直接读进程环境变量）

# ---------------- 应用 ----------------
APP_DEBUG=1

# ---------------- MySQL ----------------
# 默认值面向本仓库自带的开发实例（见 README：dedicated local MySQL on 3307）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=material_center

# ---------------- 对象存储 ----------------
# minio → 真实 MinIO；local → 本地文件系统（无 Docker 时的开发回退）
STORAGE_BACKEND=minio

S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=material-center
# MinIO 对外可访问地址（留空则用 S3_ENDPOINT + bucket 拼接）
S3_PUBLIC_BASE_URL=

# STORAGE_BACKEND=local 时生效
LOCAL_STORAGE_ROOT=./.storage

# ---------------- 上传限制 ----------------
MAX_UPLOAD_SIZE_BYTES=209715200

# ---------------- 跨域（CORS） ----------------
# 前端开发服务器来源白名单（逗号分隔）。
# 局域网访问（http://192.168.x.x:3000）由 CORS_ALLOW_ORIGIN_REGEX 覆盖，
# 不需要每换一个 IP 就改配置。
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:4173,http://127.0.0.1:4173

# 允许的来源正则（默认：本机 + 任意私网 IPv4，端口不限）
# CORS_ALLOW_ORIGIN_REGEX=^http://(localhost|127\.0\.0\.1|192\.168\.\d{1,3}\.\d{1,3})(:\d{1,5})?$
